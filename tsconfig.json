{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": [
      "./worker-configuration.d.ts",
      "node"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "workers",
    "packages",
    "apps/dashboard",
    "vite.config.ts",
    "worker-configuration.d.ts"
  ]
}
